@startuml C4-Nivel-3-Componentes
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
title C4 - Nivel 3: Componentes de la aplicación web

Person(dirigente, "Dirigente de comité", "Opera únicamente en el comité asignado.")
Person(personal, "Personal municipal autorizado", "Supervisa y resuelve operaciones según sus permisos.")
System_Ext(gateway, "Proveedor SMS / WhatsApp", "Servicio externo de mensajería.")

Container_Boundary(app, "Aplicación ASP.NET Core 10 MVC") {
  Component(vistas, "Vistas Razor", "Razor / HTML / Bootstrap", "Formularios, resultados, estados de sincronización y reportes.")
  Component(controladores, "Controladores MVC", "ASP.NET Core MVC", "Reciben solicitudes, validan el contexto de acceso y coordinan servicios.")
  Component(identidad, "Autenticación y autorización", "ASP.NET Core Identity / cookies / roles", "Controla identidad, rol y ámbito del comité.")
  Component(servicios, "Servicios de aplicación y dominio", "C#", "Reglas de inscripción, duplicados, revalidación, staging y cobertura.")
  Component(auditoria, "Servicio de auditoría", "C#", "Registra actor, fecha, operación, resultado, motivo y cambios administrativos.")
  Component(notificaciones, "Servicio de notificaciones", "C#", "Gestiona estados, reintentos limitados y errores del proveedor.")
  Component(persistencia, "Acceso a datos", "EF Core 10 / Repository / Unit of Work cuando corresponda", "Consultas y persistencia transaccional.")
}

ContainerDb(db, "Azure SQL Database", "Base de datos relacional", "Datos del sistema y eventos de auditoría.")
Rel(dirigente, vistas, "Interactúa mediante HTTPS")
Rel(personal, vistas, "Interactúa mediante HTTPS")
Rel(vistas, controladores, "Envía solicitudes")
Rel(controladores, identidad, "Verifica sesión, rol y ámbito")
Rel(controladores, servicios, "Invoca operaciones")
Rel(servicios, persistencia, "Consulta y persiste")
Rel(servicios, auditoria, "Registra operaciones relevantes")
Rel(servicios, notificaciones, "Solicita avisos")
Rel(notificaciones, gateway, "Envía notificaciones", "HTTPS")
Rel(persistencia, db, "Lee/escribe", "TLS")

SHOW_LEGEND()
@enduml
