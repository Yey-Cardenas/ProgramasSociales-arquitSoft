@startuml C4-Nivel-1-Contexto
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
title C4 - Nivel 1: Contexto del Sistema de Gestión de Programas Sociales

Person(dirigente, "Dirigente de comité", "Gestiona los registros del comité que tiene asignado.")
Person(personal, "Personal municipal autorizado", "Supervisa padrones, revisa alertas y administra las operaciones que tiene permitidas.")
System(sgps, "Sistema de Gestión de Programas Sociales", "Centraliza inscripciones del Vaso de Leche y Comedores Populares, revalidaciones, importación, reportes y auditoría.")
System_Ext(gateway, "Proveedor SMS / WhatsApp", "Servicio externo de entrega de notificaciones.")
System_Ext(padrones, "Padrones históricos", "Archivos Excel/CSV y registros en papel que se revisan antes de importar.")
System_Ext(reniec, "RENIEC / SISFOH", "Integraciones futuras fuera del alcance inicial.")

Rel(dirigente, sgps, "Registra y revisa datos de su comité")
Rel(personal, sgps, "Supervisa, autoriza importaciones y resuelve alertas")
Rel(sgps, gateway, "Solicita envío de notificaciones")
Rel(padrones, sgps, "Fuente de datos revisada para importación")
Rel(sgps, reniec, "Posible consulta en una fase futura", "Fuera del alcance inicial")

SHOW_LEGEND()
@enduml
