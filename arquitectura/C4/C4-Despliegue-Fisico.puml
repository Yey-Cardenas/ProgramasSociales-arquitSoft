@startuml C4-Despliegue-Fisico
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml
title Vista de despliegue propuesta - Sistema de Gestión de Programas Sociales

Deployment_Node(clientes, "Dispositivo del usuario", "Windows / Android 8+ sujeto a matriz de pruebas") {
  Container(browser, "Navegador web", "Chrome / Edge", "Interfaz Razor y capacidades PWA. El almacenamiento local conserva solo datos mínimos pendientes.")
}

Deployment_Node(azure, "Microsoft Azure", "Entorno cloud") {
  Deployment_Node(appservice, "Azure App Service", "Servicio administrado") {
    Container(app, "Aplicación web", "ASP.NET Core 10 MVC", "Monolito modular desplegado como una aplicación.")
  }
  Deployment_Node(sqlservice, "Azure SQL Database", "Servicio administrado de base de datos") {
    ContainerDb(db, "Base de datos SGPS", "Azure SQL Database", "Datos centrales, inscripciones, auditoría y metadatos.")
  }
}

System_Ext(gateway, "Proveedor SMS / WhatsApp", "Servicio externo de mensajería")

Rel(browser, app, "Solicitudes web y sincronización", "HTTPS")
Rel(app, db, "Acceso a datos", "Conectividad privada preferida / TLS")
Rel(app, gateway, "Solicitud de envío", "HTTPS")

note right of app
  Propuesta de despliegue, no infraestructura ya desplegada.
  No permitir acceso público irrestricto a la base de datos.
  Secretos fuera de Git; preferir identidad administrada
  y conectividad privada cuando la configuración lo permita.
end note

SHOW_LEGEND()
@enduml
